CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3000=y
# LuCI + 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
# Passwall（仅 HY2）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_passwall=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_sing-box-geoip=y
CONFIG_PACKAGE_sing-box-geosite=y
CONFIG_PACKAGE_sing-box-luci=y
# 禁用所有非 HY2 协议
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_v2ray-core=n
CONFIG_PACKAGE_trojan=n
CONFIG_PACKAGE_trojan-go=n
CONFIG_PACKAGE_naiveproxy=n
CONFIG_PACKAGE_hysteria=n
CONFIG_PACKAGE_shadowsocks-libev=n
CONFIG_PACKAGE_shadowsocks-rust=n
CONFIG_PACKAGE_sing-box-plugin-shadowsocks=n
CONFIG_PACKAGE_sing-box-plugin-vmess=n
CONFIG_PACKAGE_sing-box-plugin-trojan=n
CONFIG_PACKAGE_sing-box-plugin-hysteria=n
# rtp2httpd
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
# WiFi 驱动
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt76-connac=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-mt7981=y
# 常用工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_coreutils=y
# 网络工具
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
# UPnP
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
# DDNS
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
# opkg
CONFIG_PACKAGE_opkg=y

